<UserControl x:Class="LTS.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#F0EDE8">

    <UserControl.Resources>

        <!-- ── STAT CARD ── -->
        <Style x:Key="StatCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FDFAF7"/>
            <Setter Property="BorderBrush" Value="#DDD8D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Width" Value="180"/>
        </Style>

        <Style x:Key="StatCardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9A8F84"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="StatCardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1C1410"/>
        </Style>

        <!-- ── SECTION TITLE ── -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7B6E62"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

     

        <!-- ── PANEL BOX ── -->
        <Style x:Key="PanelBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#FDFAF7"/>
            <Setter Property="BorderBrush" Value="#DDD8D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,14"/>
        </Style>

        <!-- ── DATA GRID ── -->
        <Style x:Key="DashGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F4F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDE9E4"/>
            <Setter Property="Foreground" Value="#2A1F14"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9A8F84"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DDD8D0"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6F1FB"/>
                    <Setter Property="Foreground" Value="#0C447C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- ── ACTION BUTTONS ── -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#185FA5"/>
            <Setter Property="Foreground" Value="#E6F1FB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0C447C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B6D11"/>
            <Setter Property="Foreground" Value="#EAF3DE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#27500A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scheduler toggle button -->
        <Style x:Key="SchedulerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── LOG BADGE STYLES ── -->
        <Style x:Key="InfoBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#E6F1FB"/>
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="InfoBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0C447C"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="WarnBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAEEDA"/>
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="WarnBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#633806"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ErrorBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FCEBEB"/>
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ErrorBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#791F1F"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ── SCHEDULER TEXTBOX ── -->
        <Style x:Key="IntervalBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0C6BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2A1F14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="Dashboard"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="#1C1410"
                       VerticalAlignment="Center"/>
            <Border Background="#DDD8D0" CornerRadius="99"
                    Padding="10,3" Margin="10,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock Text="LTS v2.4"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="#6B5F52"/>
            </Border>
        </StackPanel>

        <!-- ── SCROLLABLE BODY ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── STAT CARDS ── -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">

                    <!-- Available Wafers -->
                    <Border Style="{StaticResource StatCardBorderStyle}">
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#185FA5"
                                    CornerRadius="12,12,0,0"
                                    Margin="-18,-16,-18,0"/>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="AVAILABLE WAFERS"
                                           Style="{StaticResource StatCardLabelStyle}"/>
                                <TextBlock Text="{Binding AvailableWafers}"
                                           Style="{StaticResource StatCardValueStyle}"
                                           Foreground="#185FA5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Idle Lots -->
                    <Border Style="{StaticResource StatCardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#BA7517"
                                    CornerRadius="12,12,0,0"
                                    Margin="-18,-16,-18,0"/>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="IDLE LOTS"
                                           Style="{StaticResource StatCardLabelStyle}"/>
                                <TextBlock Text="{Binding IdleLots}"
                                           Style="{StaticResource StatCardValueStyle}"
                                           Foreground="#BA7517"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Free Locations -->
                    <Border Style="{StaticResource StatCardBorderStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#3B6D11"
                                    CornerRadius="12,12,0,0"
                                    Margin="-18,-16,-18,0"/>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="FREE LOCATIONS"
                                           Style="{StaticResource StatCardLabelStyle}"/>
                                <TextBlock Text="{Binding FreeLocations}"
                                           Style="{StaticResource StatCardValueStyle}"
                                           Foreground="#3B6D11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- ── PROCESS LOCATIONS ── -->
                <TextBlock Text="PROCESS LOCATIONS"
                           Style="{StaticResource SectionTitleStyle}"/>
                <Grid Margin="0,0,0,18">

                    <ItemsControl x:Name="LocationItemsControl" ItemsSource="{Binding Locations}" Margin="0,0,0,18">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                <Border  x:Name="LocationCard" Loaded="LocationCard_Loaded" Style="{StaticResource LocationCardStyle}">
                                
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource LocationNameStyle}"/>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource LocationBadgeStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                        <Setter Property="Background" Value="#FAEEDA"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                        <Setter Property="Background" Value="#E8E6E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource LocationBadgeTextStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                            <Setter Property="Foreground" Value="#633806"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                            <Setter Property="Foreground" Value="#444441"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style></TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding CurrentLot.LotName}" />
                                </StackPanel>
                           </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                    <!-- Foreground: Carrier movement overlay (Canvas) -->
                    <Canvas x:Name="CarrierCanvas"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="999">
                     
                    </Canvas>

                </Grid>






                <!-- ── LOT + LOG TABLES ── -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LOT TABLE -->
                    <Border Grid.Column="0" Style="{StaticResource PanelBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="LOT QUEUE"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <DataGrid ItemsSource="{Binding Lots}"
                                      SelectedItem="{Binding SelectedLot}"
                                      Style="{StaticResource DashGridStyle}"
                                      Height="240">
                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Lot Code"
                                                        Binding="{Binding LotName}"
                                                        Width="120"/>

                                    <DataGridTextColumn Header="Wafers"
                                                        Binding="{Binding WaferCount}"
                                                        Width="70"/>

                                    <DataGridTemplateColumn Header="Status" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,2" CornerRadius="99"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8E6E2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LotStatus}" Value="Idle">
                                                                    <Setter Property="Background" Value="#E8E6E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LotStatus}" Value="Processing">
                                                                    <Setter Property="Background" Value="#FAEEDA"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LotStatus}" Value="Completed">
                                                                    <Setter Property="Background" Value="#EAF3DE"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LotStatus}" Value="Error">
                                                                    <Setter Property="Background" Value="#FCEBEB"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LotStatus}" Value="Queued">
                                                                    <Setter Property="Background" Value="#E6F1FB"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding LotStatus}"
                                                               FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#444441"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LotStatus}" Value="Processing">
                                                                        <Setter Property="Foreground" Value="#633806"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LotStatus}" Value="Completed">
                                                                        <Setter Property="Foreground" Value="#27500A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LotStatus}" Value="Error">
                                                                        <Setter Property="Foreground" Value="#791F1F"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LotStatus}" Value="Queued">
                                                                        <Setter Property="Foreground" Value="#0C447C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Location"
                                                        Binding="{Binding CurrentProcessLocation.Name, TargetNullValue=None, FallbackValue=None}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- LOG TABLE -->
                    <Border Grid.Column="2" Style="{StaticResource PanelBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="SYSTEM LOGS"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <DataGrid ItemsSource="{Binding Logs}"
                                      Style="{StaticResource DashGridStyle}"
                                      Height="240">
                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Timestamp"
                                                        Width="90"
                                                        Binding="{Binding Timestamp, StringFormat=HH:mm:ss}"/>

                                    <DataGridTemplateColumn Header="Level" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource InfoBadgeStyle}">
                                                                            <TextBlock Text="{Binding Level}"
                                                                                       Style="{StaticResource InfoBadgeTextStyle}"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                    <Setter Property="ContentTemplate">
                                                                        <Setter.Value>
                                                                            <DataTemplate>
                                                                                <Border Style="{StaticResource WarnBadgeStyle}">
                                                                                    <TextBlock Text="{Binding Level}"
                                                                                               Style="{StaticResource WarnBadgeTextStyle}"/>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                    <Setter Property="ContentTemplate">
                                                                        <Setter.Value>
                                                                            <DataTemplate>
                                                                                <Border Style="{StaticResource ErrorBadgeStyle}">
                                                                                    <TextBlock Text="{Binding Level}"
                                                                                               Style="{StaticResource ErrorBadgeTextStyle}"/>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Message"
                                                        Width="*"
                                                        Binding="{Binding Message}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── SCHEDULER PANEL ── -->
                <Border Style="{StaticResource PanelBoxStyle}" Margin="0,0,0,14">
                    <StackPanel>

                        <TextBlock Text="MOVEMENT MODE"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <RadioButton Content="Manual"
                                         IsChecked="{Binding IsAutoMode,
                                             Converter={StaticResource InverseBoolConverter}}"
                                         VerticalAlignment="Center"
                                         FontSize="12" Foreground="#2A1F14"
                                         Margin="0,0,16,0"/>

                            <RadioButton Content="Auto"
                                         IsChecked="{Binding IsAutoMode}"
                                         VerticalAlignment="Center"
                                         FontSize="12" Foreground="#2A1F14"
                                         Margin="0,0,20,0"/>

                            <!-- Auto-mode controls -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsAutoMode,
                                            Converter={StaticResource BoolToVisibilityConverter}}"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Every"
                                           VerticalAlignment="Center"
                                           FontSize="12" Foreground="#6B5F52"
                                           Margin="0,0,7,0"/>

                                <TextBox Text="{Binding IntervalSeconds,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource IntervalBoxStyle}"
                                         Margin="0,0,7,0"/>

                                <TextBlock Text="seconds"
                                           VerticalAlignment="Center"
                                           FontSize="12" Foreground="#6B5F52"
                                           Margin="0,0,16,0"/>

                                <!-- Separator -->
                                <Rectangle Width="1" Height="24"
                                           Fill="#DDD8D0" Margin="0,0,16,0"/>

                                <!-- Start / Stop -->
                                <Button Content="{Binding SchedulerButtonText}"
                                        Command="{Binding ToggleSchedulerCommand}">
                                    <!--Style="{StaticResource SchedulerButtonStyle}">-->
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource SchedulerButtonStyle}">
                                            <Setter Property="Background" Value="#185FA5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SchedulerRunning}" Value="True">
                                                    <Setter Property="Background" Value="#A32D2D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── ACTION BUTTONS ── -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                    <Button Content="▶  Start Process"
                            Command="{Binding StartCommand}"
                            Style="{StaticResource BlueButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button Content="→  Move to Next"
                            Command="{Binding MoveNextCommand}"
                            Style="{StaticResource GreenButtonStyle}"
                            Visibility="{Binding ShowMoveNext,
                                Converter={StaticResource BoolToVisibilityConverter}}"/>

                </StackPanel>

                <!-- ── STATUS MESSAGE ── -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#185FA5"
                           FontSize="11"
                           Margin="0,0,0,20"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>