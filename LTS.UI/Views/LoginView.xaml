<Window x:Class="LTS.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lot Tracking System — Login"
        Height="520" Width="640"
        Background="#F5EEE8"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <DrawingBrush x:Key="GridBrush" TileMode="Tile"
                      Viewport="0,0,40,40" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#20C4BAB2" Thickness="0.5"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="40,0" EndPoint="40,40"/>
                            <LineGeometry StartPoint="0,40" EndPoint="40,40"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7B6A5A"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0C6BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2A1F14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#B08060"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#B08060" BlurRadius="6"
                                                          ShadowDepth="0" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0C6BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2A1F14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#B08060"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#B08060" BlurRadius="6"
                                                          ShadowDepth="0" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ErrorPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FBF0F0"/>
            <Setter Property="BorderBrush" Value="#EEC9C9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource GridBrush}">

        <!-- Card shadow layer -->
        <Border Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="14"
                Margin="0,4,0,-4"
                Background="#C4BAB2"
                Opacity="0.6"/>

        <!-- Main card -->
        <Border Width="400"
                Padding="34,32,34,28"
                Background="#FDFAF7"
                BorderBrush="#D6CFC7"
                BorderThickness="1"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- Version badge -->
                <Border HorizontalAlignment="Left"
                        Background="#EDE0D4"
                        BorderBrush="#C9B9A8"
                        BorderThickness="1"
                        CornerRadius="99"
                        Padding="9,3"
                        Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#B08060" Margin="0,0,6,0"/>
                        <TextBlock Text="LTS v2.4"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#7B5E3E"/>
                    </StackPanel>
                </Border>

                <!-- Title block -->
                <TextBlock Text="Lot Tracking System"
                           FontSize="21" FontWeight="SemiBold"
                           Foreground="#2A1F14"
                           Margin="0,0,0,3"/>
                <TextBlock Text="Sign in to your workspace"
                           FontSize="12" Foreground="#9A8778"
                           Margin="0,0,0,22"/>

                <!-- Divider -->
                <Rectangle Height="1" Fill="#D6CFC7" Margin="0,0,0,22"/>

                <!-- Username -->
                <TextBlock Text="USERNAME" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         Margin="0,0,0,14"/>

                <!-- Password -->
                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabelStyle}"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource PasswordInputStyle}"
                             Margin="0,0,0,14"/>

                <!-- Error message -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ErrorPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="12" Foreground="#B93030"
                                   VerticalAlignment="Top" Margin="0,1,7,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#B93030" FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Login button -->
                <Button Content="Sign In"
                        Command="{Binding LoginCommand}"
                        Height="44" FontSize="13" FontWeight="SemiBold"
                        Style="{StaticResource PrimaryButtonStyle}"
                        BorderThickness="0"/>

                <!-- Footer note -->
                <TextBlock HorizontalAlignment="Center"
                           Margin="0,18,0,0"
                           FontSize="10"
                           Foreground="#B0A090">
                    <Run Text="🔒"/>
                    <Run Text=" Secured connection · Internal use only"/>
                </TextBlock>

            </StackPanel>
        </Border>
    </Grid>
</Window>