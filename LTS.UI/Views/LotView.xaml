<UserControl x:Class="LTS.UI.Views.LotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#F0EDE8">

    <UserControl.Resources>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7B6E62"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7B6A5A"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0C6BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2A1F14"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#B08060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0C6BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2A1F14"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>

        <Style x:Key="PanelBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#FDFAF7"/>
            <Setter Property="BorderBrush" Value="#DDD8D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,18"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#185FA5"/>
            <Setter Property="Foreground" Value="#E6F1FB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0C447C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FCEBEB"/>
            <Setter Property="Foreground" Value="#A32D2D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F7C1C1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9A8F84"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DDD8D0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6F1FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Lot Management"
                       FontSize="18" FontWeight="SemiBold" Foreground="#1C1410"/>
            <Border Background="#DDD8D0" CornerRadius="99"
                    Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Lots" FontSize="10" FontWeight="SemiBold" Foreground="#6B5F52"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- CREATE LOT FORM -->
                <Border Style="{StaticResource PanelBoxStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CREATE LOT" Style="{StaticResource SectionTitleStyle}"/>
                        <Rectangle Height="1" Fill="#DDD8D0" Margin="0,0,0,16"/>

                        <WrapPanel VerticalAlignment="Bottom">
                            <!-- Lot Name -->
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Lot Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource InputStyle}"
                                         Text="{Binding LotName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Carrier -->
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Select Carrier *" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Style="{StaticResource ComboStyle}"
                                          ItemsSource="{Binding AvailableCarriers}"
                                          SelectedItem="{Binding SelectedCarrier}"
                                          DisplayMemberPath="CarrierCode"/>
                            </StackPanel>

                            <!-- SUPPLIER for Fill Wafers -->

                            <StackPanel Margin="0,0,16,0" >
                                <TextBlock Text="Select Supplier"
                                        Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Style="{StaticResource ComboStyle}"
                                          ItemsSource="{Binding Suppliers}"
                                          SelectedValuePath="SupplierId"
                                          SelectedValue="{Binding SelectedSupplierId}"
                                          DisplayMemberPath="SupplierName"/>
                                
                            </StackPanel>


                        </WrapPanel>

                        <!-- FILL WAFERS BUTTON -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Fill Wafers"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding FillWafersCommand}"
                                Margin="0,0,10,0"
                                ToolTip="Auto-create wafers up to carrier capacity and assign to this lot"/>
                            
                        </StackPanel>

                        <!-- Select Wafers -->
                        <TextBlock Text="SELECT WAFERS"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,20,0,10"/>

                        <DataGrid ItemsSource="{Binding AvailableWafers}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeight="36"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDE9E4"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="#F7F4F0"
                                  BorderThickness="1"
                                  BorderBrush="#DDD8D0"
                                  Foreground="#2A1F14"
                                  FontSize="12"
                                  MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="SELECT" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="WAFER ID" Width="*" Binding="{Binding Wafer.WaferId}"/>
                                <DataGridTextColumn Header="SERIAL NUMBER" Width="*" Binding="{Binding Wafer.WaferSerialNo}"/>
                                <DataGridTextColumn Header="SUPPLIER" Width="*" Binding="{Binding Wafer.Supplier.SupplierName}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Create Lot"
                                Width="130"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CreateLotCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ALL LOTS TABLE -->
                <Border Style="{StaticResource PanelBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="ALL LOTS" Style="{StaticResource SectionTitleStyle}"/>
                        <Rectangle Height="1" Fill="#DDD8D0" Margin="0,0,0,12"/>

                        <DataGrid ItemsSource="{Binding Lots}"
                                  SelectedItem="{Binding SelectedLot}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowHeight="36"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDE9E4"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="#F7F4F0"
                                  BorderThickness="0"
                                  Foreground="#2A1F14"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LOT NAME" Width="*" Binding="{Binding LotName}"/>
                                <DataGridTextColumn Header="CARRIER" Width="*" Binding="{Binding Carrier.CarrierCode}"/>
                                <DataGridTextColumn Header="WAFERS" Width="80" Binding="{Binding WaferCount}"/>
                                <DataGridTextColumn Header="LOCATION" Width="*"
                                                    Binding="{Binding CurrentProcessLocation.Name, TargetNullValue=None, FallbackValue=None}"/>

                                <!-- STATUS -->
                                <DataGridTemplateColumn Header="STATUS" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,2" CornerRadius="99"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8E6E2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LotStatus}" Value="Idle">
                                                                <Setter Property="Background" Value="#E8E6E2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LotStatus}" Value="Processing">
                                                                <Setter Property="Background" Value="#FAEEDA"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LotStatus}" Value="Completed">
                                                                <Setter Property="Background" Value="#EAF3DE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LotStatus}" Value="Error">
                                                                <Setter Property="Background" Value="#FCEBEB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LotStatus}" Value="Queued">
                                                                <Setter Property="Background" Value="#E6F1FB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding LotStatus}"
                                                           FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#444441"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LotStatus}" Value="Processing">
                                                                    <Setter Property="Foreground" Value="#633806"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LotStatus}" Value="Completed">
                                                                    <Setter Property="Foreground" Value="#27500A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LotStatus}" Value="Error">
                                                                    <Setter Property="Foreground" Value="#791F1F"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LotStatus}" Value="Queued">
                                                                    <Setter Property="Foreground" Value="#0C447C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="CREATED ON" Width="*"
                                                    Binding="{Binding CreatedOn, StringFormat={}{0:dd-MM-yyyy HH:mm}}"/>

                                <!-- ACTION -->
                                <DataGridTemplateColumn Header="ACTION" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Delete"
                                                    Style="{StaticResource DeleteButtonStyle}"
                                                    Command="{Binding DataContext.DeleteLotCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>