<UserControl x:Class="LTS.UI.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F0EDE8">

    <UserControl.Resources>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7B6E62"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="InfoBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#E6F1FB"/>
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="WarnBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAEEDA"/>
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ErrorBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FCEBEB"/>
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9A8F84"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DDD8D0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6F1FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="System Logs"
                       FontSize="18" FontWeight="SemiBold" Foreground="#1C1410"/>
            <Border Background="#DDD8D0" CornerRadius="99"
                    Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="All Logs" FontSize="10" FontWeight="SemiBold" Foreground="#6B5F52"/>
            </Border>
        </StackPanel>

        <!-- LOG TABLE PANEL -->
        <Border Grid.Row="2"
                Background="#FDFAF7"
                BorderBrush="#DDD8D0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,18">
            <StackPanel>
                <TextBlock Text="ALL LOGS" Style="{StaticResource SectionTitleStyle}"/>
                <Rectangle Height="1" Fill="#DDD8D0" Margin="0,0,0,12"/>

                <DataGrid ItemsSource="{Binding Logs}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          RowHeight="36"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDE9E4"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#F7F4F0"
                          BorderThickness="0"
                          Foreground="#2A1F14"
                          FontSize="12">
                    <DataGrid.Columns>

                        <!-- TIMESTAMP -->
                        <DataGridTextColumn Header="TIMESTAMP" Width="120"
                                            Binding="{Binding Timestamp, StringFormat=HH:mm:ss}"/>

                        <!-- LEVEL -->
                        <DataGridTemplateColumn Header="LEVEL" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource InfoBadgeStyle}">
                                                                <TextBlock Text="{Binding Level}"
                                                                           Foreground="#0C447C"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="10"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource WarnBadgeStyle}">
                                                                        <TextBlock Text="{Binding Level}"
                                                                                   Foreground="#633806"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="10"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource ErrorBadgeStyle}">
                                                                        <TextBlock Text="{Binding Level}"
                                                                                   Foreground="#791F1F"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="10"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- MESSAGE -->
                        <DataGridTextColumn Header="MESSAGE" Width="*"
                                            Binding="{Binding Message}"/>

                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>