<Window x:Class="LTS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LTS.UI"
        mc:Ignorable="d"
        Title="Lot Tracking System" Height="700" Width="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/> <!--nav-->
            <RowDefinition Height="*"/> <!--content-->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="AntiqueWhite">
            <!--Nav-->

            <DockPanel LastChildFill="False">

                <!-- Logout Button RIGHT -->
                <Button Background="Transparent"
                    Style="{StaticResource PrimaryButtonStyle}"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0"
                    DockPanel.Dock="Right"
                    Command="{Binding LogoutCommand}">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LoggedInUser}"
                               Foreground="#000000"
                               FontSize="12"/>
                    </StackPanel>

                </Button>

                <!-- Navigation LEFT -->
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0">

                    <Button Content="Dashboard"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NavToDashboardCommand}"
                        Foreground="#000000"
                        Background="AntiqueWhite"    
                        Margin="6,5"/>

                    <Button Content="Suppliers"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NavToSupplierCommand}"
                       Foreground="#000000"
                        Background="AntiqueWhite" 
                        Margin="6,5"/>


                    <Button Content="Wafers"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NavToWaferCommand}"
                        Foreground="#000000"
                        Background="AntiqueWhite" 
                        Margin="6,5"/>
                    
                    <Button Content="Carrier"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NavToCarrierCommand}"
                        Foreground="#000000"
                        Background="AntiqueWhite" 
                        Margin="6,5"/>

                    <Button Content="Lots"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NavToLotCommand}"
                        Foreground="#000000"
                            Background="AntiqueWhite" 
                        Margin="6,5"/>

                    <Button Content="Logs"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NavToLogCommand}"
                        Foreground="#000000"
                        Background="AntiqueWhite" 
                        Margin="6,5"/>

                </StackPanel>

            </DockPanel>
           
        </Grid>

        <Grid Grid.Row="1" >
            <!--content-->
            <ContentControl Grid.Row="1"
             Content="{Binding CurrentView}"/>

        </Grid>
    </Grid>
</Window>
