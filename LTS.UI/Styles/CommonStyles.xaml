<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--reusable color-->
    <SolidColorBrush x:Key="PrimaryBrush"    Color="#0F66D4"/>
    <SolidColorBrush x:Key="LightBlueBrush"  Color="#FFB2D6E5"/>
    <SolidColorBrush x:Key="DetailsBgBrush"  Color="#FFE8F4FB"/>
    <SolidColorBrush x:Key="TextDarkBrush"   Color="#FF331616"/>
    <SolidColorBrush x:Key="TextLightBrush"  Color="#FFE3C6C6"/>
    <SolidColorBrush x:Key="ProcessingColor" Color="#0078D4"/>
    <SolidColorBrush x:Key="CompletedColor"  Color="#107C10"/>
    <SolidColorBrush x:Key="IdleColor"       Color="#606060"/>
    <SolidColorBrush x:Key="QueuedColor"     Color="#EA9700"/>
    <SolidColorBrush x:Key="ErrorColor"      Color="#C42B1C"/>
    <SolidColorBrush x:Key="AvailableColor"  Color="#107C10"/>
    <SolidColorBrush x:Key="OccupiedColor"   Color="#EA9700"/>
    <SolidColorBrush x:Key="PrimaryBlue"     Color="#185FA5"/>

    <!--button style-->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground"   Value="White"/>
        <Setter Property="Height"       Value="30"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="10,5">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <!-- Hover effect -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF0A6AAF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#FF085A96"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== TEXTBOX STYLE ======== -->
    <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
        <Setter Property="Width"           Value="220"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="Background"      Value="{StaticResource TextLightBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextDarkBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    
    <!--combox-->
    
    <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="220"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Background"  Value="{StaticResource TextLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!--TextBlock-->

    <Style x:Key="DetailTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"  Value="15"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="Margin"    Value="5,4"/>
        <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
    </Style>
    
    
    <!--LOG page-->

    <!-- Header -->
    <Style x:Key="LogHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#2D2D30"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="#3E3E42"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <!-- Rows -->
    <Style x:Key="LogRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="#252526"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- INFO Badge -->
    <Style x:Key="InfoBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#007ACC"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- WARN Badge -->
    <Style x:Key="WarnBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#D9C414"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- ERROR Badge -->
    <Style x:Key="ErrorBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#D91414"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- STAT CARD STYLES -->

    <Style x:Key="StatCardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20,14"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Width" Value="180"/>
    </Style>

    <Style x:Key="StatCardLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#555"/>
    </Style>

    <Style x:Key="StatCardValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

   



    <Style x:Key="LocationCardInnerPanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="12,10"/>
    </Style>

    <Style x:Key="LocationCardTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#380E06"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="LocationCardBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="0,6,0,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="#4CAF50"/>
    </Style>

    <Style x:Key="LocationCardBadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="LocationCardLotName" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#380E06"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>



    <!-- ── LOCATION CARD ── -->
    <Style x:Key="LocationCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#FDFAF7"/>
        <Setter Property="BorderBrush" Value="#1C1410"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,10"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Width" Value="120"/>

        <!-- RenderTransform is REQUIRED for scale animation to work -->
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>

        <Style.Triggers>


            <!-- fires when lot arrives -->
            <DataTrigger Binding="{Binding Status}" Value="Occupied">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color" From="#FFFFFF" To="#FF9800" Duration="0:0:0.8"/>
                            <!-- scale up slightly -->
                            <DoubleAnimation
                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                             From="1.0" To="1.09"
                             Duration="0:0:8"
                             RepeatBehavior="Forever"
                             AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <DoubleAnimation
                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="1.0" To="1.08"
                             Duration="0:0:0.8"
                             RepeatBehavior="Forever"                                    
                             AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                       

                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                
                <!-- fires when lot leaves -->
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                           
                            <!-- first bounce -->
                            <DoubleAnimationUsingKeyFrames
                       Storyboard.TargetProperty="RenderTransform.ScaleX">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.0"  Value="1.0"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.1"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1.0"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="1.07"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>

                            <DoubleAnimationUsingKeyFrames
                       Storyboard.TargetProperty="RenderTransform.ScaleY">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.0"  Value="1.0"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.1"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1.0"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="1.07"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1.0"/>
                            </DoubleAnimationUsingKeyFrames>

                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <!-- pulse when disabled -->
            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color" From="#2D2D3A" To="#607D8B" Duration="0:0:0.4"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LocationNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1C1410"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="LocationBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#EAF3DE"/>
        <Setter Property="CornerRadius" Value="99"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="LocationBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#27500A"/>
    </Style>
    <Style x:Key="LocationLotStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>





</ResourceDictionary>